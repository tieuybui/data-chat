# ─── Fabric Lakehouse ────────────────────────────────────────────────────────
# Copy the SQL analytics endpoint hostname from the Fabric workspace Lakehouse settings
FABRIC_SERVER=your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=your_lakehouse_name

# ─── Local SQL Server (optional fallback) ────────────────────────────────────
LOCAL_SERVER=.
LOCAL_DATABASE=your_local_db

# ─── Azure OpenAI ────────────────────────────────────────────────────────────
# These can also be entered directly in the app sidebar UI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=your-api-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
